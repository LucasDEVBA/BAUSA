# ─── Frontend (Supabase) ────────────────────────────────────────────────────────
# Obtenha em: Supabase Dashboard → Project Settings → API
# No Lovable, estas vars são injetadas automaticamente via Project Settings → Env Vars
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ─── Next.js (CRM) ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ─── Integrações CRM ───────────────────────────────────────────────────────────
DOCUSIGN_HMAC_KEY=
CALENDLY_URL=
SEND_WHATSAPP_URL=
WEBHOOK_SECRET=

# ─── Tracking (GTM) ──────────────────────────────────────────────────────────
NEXT_PUBLIC_GTM_ID=

